{
  "说明": "文风规则的参数。改这里即改全文检查口径，不需要动脚本。",
  "owner": "sivan",
  "reviewMonths": 6,
  "limits": {
    "句子最多字": 80,
    "段落最多行": 9,
    "标题最多级": 3
  },
  "requiredFrontmatter": [
    "owner",
    "reviewed",
    "reviewBy",
    "sources"
  ],
  "excludeFromFrontmatter": [
    "index.md",
    "glossary.md"
  ],
  "skipWordRules": [
    "glossary.md"
  ],
  "conventions": {
    "说明": "章节写法的可检查部分，见 tools/check-conventions.py。",
    "方法章目录": [
      "foundations",
      "ai",
      "engineering",
      "agent",
      "cases"
    ],
    "角色页目录": [
      "roles"
    ],
    "二级标题上限": 8,
    "延伸阅读上限": 3,
    "不设的小节": [
      "视频"
    ]
  },
  "defensive": {
    "说明": "防御性的话：预先回答读者没有提出的质疑。正则，命中即报。",
    "交代素材怎么来": [
      "有完整的(会话)?记录",
      "记录里能查到",
      "出自[^。\\n]{0,14}复盘",
      "我回看了自己"
    ],
    "交代素材怎么处理过": [
      "做了(替换|匿名|改写|脱敏)",
      "略有整理",
      "原文是英文",
      "译文如下"
    ],
    "声明例子的性质": [
      "不是真实记录",
      "示意的例子",
      "仅为示意",
      "改写的典型场景",
      "不(对应|指向)任何具体",
      "不是「?错误示范"
    ],
    "例子后面再解释一遍": [
      "尤其有用",
      "每一条都能(被)?核对"
    ],
    "给结论加免责": [
      "未核对",
      "仅供参考",
      "需要说明的是",
      "这是当时的快照"
    ]
  }
}
