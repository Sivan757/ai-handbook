{
  "说明": "术语表的唯一来源。改这里，跑 pnpm run glossary 重新生成 docs/glossary.md，跑 pnpm lint 检查全文用法。",
  "terms": [
    {
      "term": "任务简报",
      "aka": [
        "提示词包",
        "提示词模板",
        "prompt 模板",
        "需求描述模板",
        "任务描述"
      ],
      "note": "给 AI 布置独立任务时按五格（目标、背景、约束、验收、输出）写的那段话"
    },
    {
      "term": "交接单",
      "aka": [
        "交接说明",
        "交接摘要"
      ],
      "note": "长会话聊乱或换人接手时写的交接文件；章节和模板页标题用「会话交接」，正文与文件内统一称交接单"
    },
    {
      "term": "项目指令",
      "aka": [
        "项目配置",
        "项目规则",
        "AGENTS 文件",
        "CLAUDE.md 文件",
        "规则文件"
      ],
      "note": "仓库或工作区根目录里给 AI 看的长期约定。具体文件名照实写 AGENTS.md"
    },
    {
      "term": "全局指令",
      "aka": [
        "全局规则",
        "个人指令",
        "系统提示词",
        "人设"
      ],
      "note": "个人跨所有项目生效的通用习惯，放在工具个人配置里"
    },
    {
      "term": "系统提示",
      "aka": [],
      "note": "工具自带的行为规则与工具清单，区别于用户自己写的全局指令与项目指令"
    },
    {
      "term": "技能",
      "aka": [
        "skill 包",
        "技能包"
      ],
      "note": "按需加载的专项流程说明；打包工具统一写作 skill-creator（可注部分工具叫 skills-creator）"
    },
    {
      "term": "项目技能",
      "aka": [
        "团队技能"
      ],
      "note": "跟着代码一起提交进 Git 仓库、给全组共用的按需技能"
    },
    {
      "term": "Harness",
      "aka": [
        "运行框架"
      ],
      "note": "能接通本地文件、命令与浏览器等工具的 AI 工作台；首次出现可用「工作台」或「架子」作中文括注"
    },
    {
      "term": "智能体",
      "aka": [
        "AI 智能体",
        "AI Agent",
        "编程 Agent",
        "agent 智能体",
        "AI 代理",
        "代理程序"
      ],
      "note": "带着 Harness 能调工具、分步干活的 AI。泛指时用智能体（可带括注 Agent），具体产品名照写"
    },
    {
      "term": "子代理",
      "aka": [
        "teammate",
        "子会话",
        "subagent"
      ],
      "note": "主会话派出去、拥有独立上下文的助手会话"
    },
    {
      "term": "会话",
      "aka": [
        "对话窗口",
        "聊天会话"
      ],
      "note": "一次连续的对话"
    },
    {
      "term": "上下文",
      "aka": [
        "语境",
        "context 窗口",
        "上下文窗口"
      ],
      "note": "一次请求里模型能看到的全部内容"
    },
    {
      "term": "上下文工程",
      "aka": [
        "上下文管理",
        "prompt 工程"
      ],
      "note": "决定哪些内容进入上下文"
    },
    {
      "term": "验证",
      "aka": [
        "校验一下",
        "核实过程"
      ],
      "note": "用可执行的方式或对照原始依据确认结果对不对"
    },
    {
      "term": "未验证",
      "aka": [
        "待核实",
        "未找到依据",
        "未核对"
      ],
      "note": "查不到原始出处或尚未实测确认时的统一占位标记"
    },
    {
      "term": "验收标准",
      "aka": [
        "验收条件",
        "验收标准描述",
        "完成定义",
        "验收判据"
      ],
      "note": "事先约定的可核对完成判据（任务简报五格栏位简标为「验收」）"
    },
    {
      "term": "自查",
      "aka": [
        "自检"
      ],
      "note": "交稿或交付前对照清单先核对一遍"
    },
    {
      "term": "合并请求",
      "aka": [
        "MR 请求",
        "Pull Request 请求",
        "PR 单"
      ],
      "note": "MR、PR 可以作为缩写出现，但正文概念统一叫合并请求"
    },
    {
      "term": "保护分支",
      "aka": [
        "主干分支"
      ],
      "note": "禁止直接推送、必须经合并请求合入的长期分支（如 master / main、release、dev）"
    },
    {
      "term": "特性分支",
      "aka": [
        "功能分支",
        "feature 分支的中文混写"
      ],
      "note": "从长期分支拉出来做一件事的临时分支"
    },
    {
      "term": "工作树",
      "aka": [
        "工树"
      ],
      "note": "git worktree 开出的独立工作目录，用来多分支并行开发"
    },
    {
      "term": "约定式提交",
      "aka": [
        "规范提交"
      ],
      "note": "按「类型(范围): 描述」书写的 Git 提交信息规范"
    },
    {
      "term": "复盘",
      "aka": [
        "回顾会议纪要",
        "postmortem 报告"
      ],
      "note": "事后按「发生了什么、怎么恢复的、错在哪、下次怎么做」四节写的记录"
    },
    {
      "term": "决策记录",
      "aka": [
        "架构决策记录"
      ],
      "note": "按「背景、决定、否掉的方案、后果」写下的选型记录，工程里常简称为 ADR"
    },
    {
      "term": "踩坑记录",
      "aka": [
        "坑记录",
        "问题记录"
      ],
      "note": "日常踩坑或取舍用的五行卡片（以为、实际、原因、怎么看出来、以后）"
    }
  ],
  "banned": [
    {
      "word": "作者",
      "why": "第一人称写，用「我」",
      "fix": "我"
    },
    {
      "word": "读者们",
      "why": "不用复数呼语",
      "fix": "你"
    },
    {
      "word": "大家",
      "why": "指代不清，写清是谁",
      "fix": "你"
    },
    {
      "word": "众所周知",
      "why": "假设读者已知，去掉",
      "fix": ""
    },
    {
      "word": "显而易见",
      "why": "同上",
      "fix": ""
    },
    {
      "word": "值得注意的是",
      "why": "填充词",
      "fix": ""
    },
    {
      "word": "需要注意的是",
      "why": "填充词，直接写要注意什么",
      "fix": ""
    },
    {
      "word": "综上所述",
      "why": "填充词",
      "fix": ""
    },
    {
      "word": "核验",
      "why": "编辑过程的词，不进正文",
      "fix": "验证"
    },
    {
      "word": "待确认",
      "why": "编辑状态不进正文",
      "fix": ""
    },
    {
      "word": "本文将",
      "why": "元叙述",
      "fix": ""
    },
    {
      "word": "本文档旨在",
      "why": "元叙述",
      "fix": ""
    },
    {
      "word": "这一章解决什么",
      "why": "模板开头，读起来像模型在交作业",
      "fix": "换成一句把人带进场景的话"
    },
    {
      "word": "本节将",
      "why": "元叙述",
      "fix": "删掉"
    },
    {
      "word": "总而言之",
      "why": "填充词",
      "fix": "删掉"
    }
  ],
